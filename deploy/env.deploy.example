# 本机 deploy/.env.deploy 的模板（复制后填写；.env.deploy 不进仓库）。只放连接信息，不放任何密码。

# 服务器的 SSH 目标，形如 用户名@地址
DEPLOY_HOST=<user>@<server>
# SSH 端口
DEPLOY_SSH_PORT=22
# 服务器上的部署目录，相对于登录用户的主目录（即 ~/quiz-javaweb；这里不要写 ~）
DEPLOY_DIR=quiz-javaweb
# 可选：放在 ssh / rsync 的 ssh 前面的命令。服务器只能用密码登录时用 sshpass，
# 密码写在只有自己能读的文件里（chmod 600），这里只写文件路径，例如：
#   DEPLOY_SSH_PREFIX="sshpass -f /home/me/.quiz-deploy-pw"
# 留空表示用密钥登录（此时 ssh 加 BatchMode=yes，不会卡在密码提示上）
DEPLOY_SSH_PREFIX=
# 服务器上调用 docker 的方式；登录用户不在 docker 组时设成 "sudo docker"
# （sudo 要密码时，deploy.sh 会给 ssh 分配终端，运行时按提示输入）
DEPLOY_DOCKER=docker
# 可选：本机的 Android 安装包路径，填了就一起传到 /quiz/download/quiz.apk
APK_PATH=
# 部署后在服务器上检查的健康接口
HEALTH_URL=http://127.0.0.1:18090/quiz/api/app/version?platform=android
