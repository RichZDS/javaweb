# 服务器上 ~/quiz-javaweb/.env 的模板：复制成 .env 后把 <...> 换成真实值。.env 不进仓库，只放在服务器上。
# 生成随机串可以用：openssl rand -base64 48

# MySQL root 密码（只给数据库容器和 backup.sh 用）
MYSQL_ROOT_PASSWORD=<改成随机密码>
# 后端连接数据库的 quiz 用户的密码
DB_PASSWORD=<改成随机密码>
# JWT 签名密钥，至少 32 字节；改掉它会让所有人重新登录
JWT_SECRET=<改成至少 32 字节的随机串>

# 启动时如果库里没有管理员，就用下面的账号创建一个（之后改这里不会改已有账号的密码）
ADMIN_USERNAME=admin
ADMIN_PASSWORD=<改成管理员初始密码>

# 首次部署设为 true 导入示例题库（只在分类表为空时导入），导入后改回 false
APP_SEED_ENABLED=false

# GET /api/app/version 返回的版本信息，App 用来提示升级
APP_RELEASE_ANDROID_LATEST_VERSION=1.0.0
APP_RELEASE_ANDROID_MIN_VERSION=1.0.0
# 安装包地址，例如 https://<服务器地址>/quiz/download/quiz.apk
APP_RELEASE_ANDROID_DOWNLOAD_URL=
APP_RELEASE_ANDROID_NOTES=
APP_RELEASE_IOS_LATEST_VERSION=1.0.0
APP_RELEASE_IOS_MIN_VERSION=1.0.0
APP_RELEASE_IOS_DOWNLOAD_URL=
APP_RELEASE_IOS_NOTES=
